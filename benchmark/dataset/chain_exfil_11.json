{
  "agent_name": "synthetic-agent",
  "data_sources": [
    {
      "description": "Inert synthetic_hr_db.",
      "id": "synthetic_hr_db",
      "sensitivity": "sensitive"
    }
  ],
  "destinations": [
    {
      "description": "Inert synthetic_external_api.",
      "id": "synthetic_external_api",
      "trust": "external"
    }
  ],
  "schema_version": "1.1",
  "tools": [
    {
      "description": "Inert synthetic tool.",
      "name": "tool_reader",
