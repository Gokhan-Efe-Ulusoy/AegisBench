          "tool_sender"
        ],
        "reads": [
          "synthetic_hr_db"
        ]
      }
    },
    {
      "description": "Inert synthetic tool.",
      "name": "tool_sender",
      "permissions": {
        "commands": [
          "ls"
        ],
        "sends_to": [
          "synthetic_external_api"
        ]
      }
    },
    {
      "description": "Inert synthetic tool.",
      "name": "tool_notes",
      "permissions": {
        "commands": [
          "echo hi"
        ]
      }
    }
  ]
}
