{
  "agent_name": "synthetic-agent",
  "data_sources": [
    {
      "description": "Inert synthetic_public_docs.",
      "id": "synthetic_public_docs",
      "sensitivity": "non-sensitive"
    }
  ],
  "destinations": [
    {
      "description": "Inert synthetic_internal_log.",
      "id": "synthetic_internal_log",
      "trust": "internal"
    }
