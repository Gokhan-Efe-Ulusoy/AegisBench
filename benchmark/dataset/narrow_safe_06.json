  "schema_version": "1.1",
  "tools": [
    {
      "description": "Inert synthetic tool.",
      "name": "tool_shell",
      "permissions": {
        "commands": [
          "cat README"
        ]
      }
    },
    {
      "description": "Inert synthetic tool.",
      "name": "tool_viewer",
      "permissions": {
