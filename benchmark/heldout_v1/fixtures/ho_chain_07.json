{
  "agent_name": "heldout-agent",
  "data_sources": [
    {
      "id": "heldout_patient_records",
      "sensitivity": "sensitive"
    },
    {
      "id": "heldout_public_faq",
      "sensitivity": "non-sensitive"
    }
  ],
  "destinations": [
    {
      "id": "heldout_partner_api",
      "trust": "external"
    },
    {
      "id": "heldout_public_feed",
      "trust": "external"
    }
  ],
  "schema_version": "1.1",
  "tools": [
    {
      "description": "Inert heldout tool.",
