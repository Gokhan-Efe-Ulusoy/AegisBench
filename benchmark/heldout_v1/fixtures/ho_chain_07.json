      "permissions": {
        "invokes": [
          "sa"
        ],
        "reads": [
          "heldout_patient_records"
        ]
      }
    },
    {
      "description": "Inert heldout tool.",
      "name": "sa",
      "permissions": {
        "sends_to": [
          "heldout_partner_api"
        ]
      }
    },
    {
      "description": "Inert heldout tool.",
      "name": "rb",
      "permissions": {
        "invokes": [
          "sb"
        ],
        "reads": [
          "heldout_public_faq"
        ]
      }
    },
    {
      "description": "Inert heldout tool.",
      "name": "sb",
      "permissions": {
        "sends_to": [
          "heldout_public_feed"
        ]
      }
    }
  ]
}
